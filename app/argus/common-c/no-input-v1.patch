+static void setConnectionStartFlags(uint32_t startFlags) {
+#ifdef _WIN32
+    InterlockedExchange(&ConnectionStartFlags, (long)startFlags);
+#else
+    __atomic_store_n(&ConnectionStartFlags, (long)startFlags, __ATOMIC_RELEASE);
+#endif
+}
+
+static uint32_t getConnectionStartFlags(void) {
+#ifdef _WIN32
+    return (uint32_t)InterlockedCompareExchange(&ConnectionStartFlags, 0, 0);
+#else
+    return (uint32_t)__atomic_load_n(&ConnectionStartFlags, __ATOMIC_ACQUIRE);
+#endif
+}
+
+bool isInputStreamDisabled(void) {
+    return (getConnectionStartFlags() & LI_START_FLAG_DISABLE_INPUT_STREAM) != 0;
+}
+
+#ifdef LC_TEST_INPUT_ISOLATION
+uint32_t LiTestGetInputInitializeCount(void) {
+    return testInputInitializeCount;
+}
+
+uint32_t LiTestGetInputStartCount(void) {
+    return testInputStartCount;
+}
+
+void LiTestResetConnectionInputIsolationCounters(void) {
+    testInputInitializeCount = 0;
+    testInputStartCount = 0;
+}
+#endif
+
+static void initializeInputForAttempt(void) {
+    if (isInputStreamDisabled()) {
+        return;
+    }
+
+    Limelog("Initializing input stream...");
+    ListenerCallbacks.stageStarting(STAGE_INPUT_STREAM_INIT);
+#ifdef LC_TEST_INPUT_ISOLATION
+    testInputInitializeCount++;
+#endif
+    initializeInputStream();
+    inputInitialized = true;
+    ListenerCallbacks.stageComplete(STAGE_INPUT_STREAM_INIT);
+    Limelog("done\n");
+}
+
+static int startInputForAttempt(void) {
+    if (isInputStreamDisabled()) {
+        return 0;
+    }
+
+    Limelog("Starting input stream...");
+    ListenerCallbacks.stageStarting(STAGE_INPUT_STREAM_START);
+#ifdef LC_TEST_INPUT_ISOLATION
+    testInputStartCount++;
+#endif
+    int err = startInputStream();
+    if (err != 0) {
+        Limelog("Input stream start failed: %d\n", err);
+        ListenerCallbacks.stageFailed(STAGE_INPUT_STREAM_START, err);
+        return err;
+    }
+    inputStarted = true;
+    ListenerCallbacks.stageComplete(STAGE_INPUT_STREAM_START);
+    Limelog("done\n");
+    return 0;
+}
+
+static void wakeDisplayForAttempt(void) {
+    if (isInputStreamDisabled()) {
+        return;
+    }
+
+    LiSendMouseMoveEvent(1, 1);
+    PltSleepMs(10);
+    LiSendMouseMoveEvent(-1, -1);
+    PltSleepMs(10);
+}
+
+#ifdef LC_TEST_INPUT_ISOLATION
+void LiTestExerciseInputStages(void) {
+    initializeInputForAttempt();
+    (void)startInputForAttempt();
+    wakeDisplayForAttempt();
+}
+#endif
